NODE_ENV=development
PORT=5001
# MongoDB Connection String (Local or MongoDB Atlas)
DATABASE_URL="mongodb://127.0.0.1:27017/phulpur_blood_network"

BCRYPT_SALT_ROUND=10
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Authentication & JWT
JWT_SECRET=phulpur_blood_network_super_secret_jwt_key_2026
JWT_EXPIRE_IN=15m
JWT_REFRESH_EXPIRE_IN=30d
# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Keep-Alive & Self Ping URL (for 14 min cron job)
SERVER_URL=http://localhost:5001

# Email Provider Configuration (resend | smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ফুলপুর ব্লাড ডোনার নেটওয়ার্ক <noreply@phulpur-blood.org>"
APP_BASE_URL=http://localhost:3000

# SMTP Fallback Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# Super Admin Seed Credentials
NAME="Super Admin"
EMAIL="admin@phulpur.org"
PHONE="01972606255"
PASSWORD="AdminPassword123!"
AVATAR="https://i.ibb.co/VWkMFBWM/pngtree-user-icon-png-image-1796659.jpg"

FRONTEND_URL=http://localhost:3000
